<% content_for :title, "Hold #{@hold.token}" %>
<%= link_to "← trip", trip_path(@hold.trip, keep_search), class: "back" %>

<h1>Seats held</h1>
<p class="timer" data-controller="timer" data-timer-seconds-value="<%= @hold.seconds_left %>">
  expires in <%= @hold.seconds_left %> sec
</p>
<p class="meta">hold <%= @hold.token %></p>

<ul>
  <% @trip_seats.each do |trip_seat| %>
    <li><%= trip_seat.seat.number %> · <%= rupees(trip_seat.fare) %></li>
  <% end %>
</ul>
<p><strong>total <%= rupees(@trip_seats.sum(&:fare)) %></strong></p>

<div class="actions">
  <%= button_to "confirm booking", hold_bookings_path(@hold.token), method: :post %>
  <%= link_to "← search", trips_path(keep_search), class: "back" %>
</div>
