<% content_for :title, "Find a bus" %>
<h1>Find a bus</h1>

<%= form_with url: trips_path, method: :get, class: "filters" do %>
  <div>
    <label>From</label>
    <%= select_tag :from, options_for_select(@cities, @from), prompt: "pick a city" %>
  </div>
  <div>
    <label>To</label>
    <%= select_tag :to, options_for_select(@cities, @to), prompt: "pick a city" %>
  </div>
  <div>
    <label>Date</label>
    <%= date_field_tag :on, @on %>
  </div>
  <div>
    <label>Min operator rating</label>
    <%= number_field_tag :min_rating, params[:min_rating], step: 0.1, min: 0, max: 5 %>
  </div>
  <div>
    <label>Price from</label>
    <%= number_field_tag :min_price, params[:min_price] %>
  </div>
  <div>
    <label>Price up to</label>
    <%= number_field_tag :max_price, params[:max_price] %>
  </div>
  <div>
    <label>AC</label>
    <%= select_tag :ac_type, options_for_select([["any", ""], ["Non-AC", "non_ac"], ["AC", "ac"]], params[:ac_type]) %>
  </div>
  <div>
    <label>Layout</label>
    <%= select_tag :layout_type, options_for_select([["any", ""], ["Seater", "seater"], ["Sleeper", "sleeper"]], params[:layout_type]) %>
  </div>
  <div class="full">
    <label>Amenity</label>
    <%= select_tag :amenity, options_for_select([["any", ""]] + Amenity.order(:name).pluck(:name, :name), params[:amenity]) %>
  </div>
  <div class="full">
    <%= submit_tag "search" %>
  </div>
<% end %>

<% if @from && @to && @on && @trips.empty? %>
  <p class="meta">no buses on that date for <%= @from %> → <%= @to %>.</p>
<% elsif @trips.any? %>
  <p class="meta"><%= @trips.size %> <%= @trips.size == 1 ? "trip" : "trips" %></p>
<% else %>
  <p class="meta">pick from and to, then search.</p>
<% end %>

<% @trips.each do |trip| %>
  <%= link_to trip_path(trip, keep_search), class: "card" do %>
    <h2><%= trip.bus.operator.name %> <span class="meta"><%= trip.bus.operator.rating %>★</span></h2>
    <p>
      <%= trip.origin %> → <%= trip.destination %>
      · <%= trip.depart_at.strftime("%d %b, %H:%M") %>
      · <%= bus_tag(trip.bus) %>
    </p>
    <p class="meta">
      <%= rupees(trip.min_fare) %>–<%= rupees(trip.max_fare) %>
      · <%= trip.available_seats %> open
      · <%= trip.bus.amenities.map(&:name).join(", ") %>
    </p>
    <span class="btn">pick seats</span>
  <% end %>
<% end %>
